                      "zh/manual/v1.3.0/installation/driver"
                    ]
                  },
                  {
                    "group": "配置",
                    "icon": "sliders",
                    "pages": [
                      "zh/manual/v1.3.0/configuration/start",
                      "zh/manual/v1.3.0/configuration/ui",
                      "zh/manual/v1.3.0/configuration/file"
                    ]
                  },
                  {
                    "group": "功能",
                    "icon": "bolt",
                    "pages": [
                      "zh/manual/v1.3.0/features/core",
                      "zh/manual/v1.3.0/features/timer"
                    ]
