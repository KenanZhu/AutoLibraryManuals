{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AutoLibrary Manuals",
  "colors": {
    "primary": "#0d9488",
    "light": "#64ffda",
    "dark": "#0d9488"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "用户手册",
        "languages": [
          {
            "language": "zh",
            "default": true,
            "groups": [
              {
                "group": "开始",
                "icon": "book-open",
                "pages": [
                  "zh/index/intro",
                  "zh/index/beforestart"
                ]
              },
              {
                "group": "安装",
                "icon": "download",
                "pages": [
                  "zh/installation/install",
                  "zh/installation/driver"
                ]
              },
              {
                "group": "配置",
                "icon": "sliders",
                "pages": [
                  "zh/configuration/start",
                  "zh/configuration/ui",
                  "zh/configuration/file"
                ]
              },
              {
                "group": "功能",
                "icon": "bolt",
                "pages": [
                  "zh/features/core",
                  "zh/features/timer"
                ]
              },
              {
                "group": "FAQ",
                "icon": "circle-question",
                "pages": [
                  "zh/faq/troubleshooting",
                  "zh/faq/faq",
                  "zh/faq/contact"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "AutoLibrary 下载页面",
        "href": "https://autolibrary.kenanzhu.com/downloads"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/KenanZhu/AutoLibrary",
        "icon": "github"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/KenanZhu/AutoLibrary"
    }
  }
}
